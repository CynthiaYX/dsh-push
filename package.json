{
  "name": "dsh-push",
  "version": "0.2.1",
  "description": "Push DeepSeek Harness agent lifecycle notifications to configurable channels",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CynthiaYX/dsh-push.git"
  },
  "homepage": "https://github.com/CynthiaYX/dsh-push#readme",
  "bugs": {
    "url": "https://github.com/CynthiaYX/dsh-push/issues"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "config.example.json",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "node test/run.ts",
    "prepublishOnly": "tsdown && node test/run.ts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-commands": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-commands": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@types/node": "22.20.0",
    "tsdown": "0.22.2",
    "typescript": "6.0.3"
  }
}
